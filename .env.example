# انسخ هذه الأسماء لمتغيرات Render (Environment). لا تضع القيم الحقيقية بأي ملف داخل GitHub.

APP_URL=https://your-service.onrender.com

# قاعدة البيانات (إلزامية بالإنتاج)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# الأدمن: اسم المستخدم ← البريد ← كلمة السر ← كود للبريد. ولّد السطر بـ: npm run make-admin -- musab you@example.com
# (يحتاج مزوّد البريد بالأسفل)
ADMINS=
# بديل: الدخول بكود البريد فقط (بريد أو أكثر بفواصل)
ADMIN_EMAILS=

# CyberBot: اختر واحداً
GEMINI_API_KEY=
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=

# تأكيد البريد وإرسال روابط كلمة السر (اختر مزوّداً واحداً)
# Brevo مجاني (300 رسالة يومياً): وثّق عنوان مرسل واحد من لوحة Brevo ثم ضعه بـ MAIL_FROM
BREVO_API_KEY=
# RESEND_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Phishing Detector

# الدفع والتواصل
# الدفع بالماستر كارد (Qi Card) فقط
PAY_QICARD=
CONTACT_WHATSAPP=
CONTACT_TELEGRAM=
PAYMENT_NOTE=
PRICE_USD=2
PRICE_IQD=3000
TRIAL_DAYS=30

# الدخول الخارجي (اختياري)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# عنوان الزائر الحقيقي (اختياري): الترويسة التي يضعها الوسيط ولا يستطيع الزائر تزويرها.
# الافتراضي true-client-ip. تأكد منها بعد الدخول للأدمن بفتح /api/admin/ipcheck
# CLIENT_IP_HEADER=true-client-ip

# الظهور بمحركات البحث (اختياري): رمز التوثيق من Google Search Console (طريقة HTML tag، انسخ قيمة content فقط)
GOOGLE_SITE_VERIFICATION=
# ورمز Bing Webmaster Tools (قيمة content من msvalidate.01)
BING_SITE_VERIFICATION=
