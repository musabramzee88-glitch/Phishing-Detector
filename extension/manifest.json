{
  "manifest_version": 3,
  "name": "Phishing Detector - كاشف التصيد",
  "short_name": "Phishing Detector",
  "version": "1.0.0",
  "description": "يحذّرك من صفحات التصيد قبل ما تفتحها. الفحص يصير داخل متصفحك، وما نرسل الروابط اللي تزورها لأي جهة.",
  "default_locale": "ar",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Phishing Detector" },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "storage", "alarms", "webNavigation", "activeTab"],
  "host_permissions": ["__SITE_ORIGIN__/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
